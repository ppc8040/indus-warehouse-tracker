# ══════════════════════════════════════════════════════════════════
#  Indus Warehouse Tracker — Environment Variables
#  Copy to .env for local dev, or set as Heroku Config Vars
# ══════════════════════════════════════════════════════════════════

# Flask
SECRET_KEY=your-random-secret-key-here
FLASK_DEBUG=false

# Microsoft Entra (Azure AD) App Registration
GRAPH_TENANT_ID=ed97e9bb-e119-4bd4-ab00-307d64bdf908
GRAPH_CLIENT_ID=your-client-id-here
GRAPH_CLIENT_SECRET=your-client-secret-here

# SharePoint site ID (composite siteId,webId)
SHAREPOINT_SITE_ID=201c767f-23cc-4eff-b76c-47a275706531,094b21f9-6ed4-47c3-a751-3b217a18b98e

# Workbook filename (in Shared Documents root)
WORKBOOK_FILENAME=Indus Warehouse Stock Movement.xlsx

# Factory floor auth
SUPERVISOR_PIN=9999
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-strong-password

# Optional tuning
GRAPH_REQUEST_TIMEOUT=30
GRAPH_MAX_RETRIES=3
